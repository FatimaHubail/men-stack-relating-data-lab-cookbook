<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Recipes</title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <h1>Welcome to my Recipes</h1>
        <a href="/users/<%= user._id %>/recipes/new">Add New Recipe</a>

        <!-- Recipes -->
        <ul>
            <% if (recipes.length===0) { %>
                <p>There are no recipes in this collection</p>
                <% } else { %>
                    <% recipes.forEach((recipe)=> { %>
                        <li>
                            <a href="/users/<%= user._id %>/recipes/<%= recipe._id %>"><%= recipe.name %></a>
                        </li>
                        <% }) %>
                            <% } %>
        </ul>
</body>

</html>