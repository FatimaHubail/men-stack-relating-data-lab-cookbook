<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editing <%=recipe.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <h1>Editing <%=recipe.name%>
        </h1>

        <form action="/users/<%=user._id%>/recipes/<%=recipe._id%>?_method=PUT" method="POST">
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" value="<%=recipe.name%>" />

            <label for="ingredients">Ingredients:</label>
            <input type="text" name="ingredients" id="ingredients" value="<%=recipe.ingredients%>" /> 

            <label for="instructions">Instructions:</label>
            <input type="text" name="instructions" id="instructions" value="<%=recipe.instructions%>" />

            <button type="submit">edit Recipe</button>
        </form>
</body>

</html>