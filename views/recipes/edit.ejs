<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editing <%=recipe.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <h1>Editing <%=recipe.name%>
        </h1>

        <form action="/users/<%=user._id%>/recipes/<%=recipe._id%>?_method=PUT" method="POST">
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" value="<%=recipe.name%>" />

            <fieldset>
                <legend>Ingredients:</legend>
                <% ingredients.forEach(function(ingredient) { %>
                    <label>
                        <input type="checkbox" name="ingredients" value="<%= ingredient._id %>" <% if (recipe.ingredients.some(id=>
                        id.toString() === ingredient._id.toString())) { %>checked<% } %>
                            >
                            <%= ingredient.name %>
                    </label>
                    <% }); %>
            </fieldset>

            <label for="instructions">Instructions:</label>
            <textarea name="instructions" id="instructions"><%=recipe.instructions%></textarea>

            <button type="submit">edit Recipe</button>
        </form>
</body>

</html>