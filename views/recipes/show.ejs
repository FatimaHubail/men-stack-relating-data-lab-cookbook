<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= recipe.name %></title>
</head>

<body>
    <%- include('../partials/_navbar') %>

    <h1><%= recipe.name %></h1>

    <h3>Ingredients</h3>
    <% if (recipe.ingredients && recipe.ingredients.length) { %>
        <ul class="grid-list">
            <% recipe.ingredients.forEach(function(ingredient) { %>
                <li>
                    <%= ingredient.name %>
                </li>
                <% }); %>
        </ul>
        <% } else { %>
            <p>No ingredients added yet.</p>
            <% } %>

            <fieldset class="instructions-box">
                <legend>Instructions:</legend>
                <p>
                    <%= recipe.instructions %>
                </p>
            </fieldset>

                <div class="recipe-actions">
                    <a class="edit-btn" href="/users/<%= userId %>/recipes/<%= recipe._id %>/edit">
                        Edit Recipe
                    </a>
                
                    <form action="/users/<%= userId %>/recipes/<%= recipe._id %>?_method=DELETE" method="POST">
                        <button class="delete-btn" type="submit">Delete Recipe</button>
                    </form>
                </div>


</body>

</html>