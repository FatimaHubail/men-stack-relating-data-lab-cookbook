<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= recipe.name %></title>
</head>

<body>
    <%- include('../partials/_navbar') %>

    <h1><%= recipe.name %></h1>

    <h3>Instructions</h3>
    <p><%= recipe.instructions %></p>

    <h3>Ingredients</h3>
    <% if (recipe.ingredients && recipe.ingredients.length) { %>
        <ul>
            <% recipe.ingredients.forEach(function(ingredient) { %>
                <li>
                    <%= ingredient.name %>
                </li>
                <% }); %>
        </ul>
        <% } else { %>
            <p>No ingredients added yet.</p>
            <% } %>

                <a href="/users/<%= userId %>/recipes/<%= recipe._id %>/edit">Edit Recipe</a>

                <form action="/users/<%= userId %>/recipes/<%= recipe._id %>?_method=DELETE" method="POST">
                    <button type="submit">Delete Recipe</button>
                </form>

                <a href="/users/<%= userId %>/recipes">Back to Recipes</a>

</body>

</html>