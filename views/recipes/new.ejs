<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Recipe</title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <h1>Add New Recipe</h1>

        <form action="/users/<%= user._id %>/recipes/new" method="post">
            <label for="name">Recipe Name:</label>
            <input type="text" name="name" id="name" />

            <fieldset>
                <legend>Ingredients:</legend>
                <% ingredients.forEach(function(ingredient) { %>
                    <label>
                        <input type="checkbox" name="ingredients" value="<%= ingredient._id %>">
                        <%= ingredient.name %>
                    </label>
                    <% }); %>
            </fieldset>
            
            <p>Don't see an ingredient you need? <a href="/ingredients" target="_blank">Add one here</a>, then refresh this page.</p>

            <label for="instructions">Instructions:</label>
            <textarea name="instructions" id="instructions"></textarea>

            <button type="submit">Add Recipe</button>
        </form>
</body>

</html>