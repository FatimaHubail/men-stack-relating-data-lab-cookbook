<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
</head>

<body>
    <%- include('../partials/_navbar') %>
    <h1>Welcome to my Pantry</h1>
    <a href="/users/<%= user._id %>/foods/new">Add New Item</a>

    <!-- Items -->
    <ul>
        <% if (foods.length===0) { %>
            <p>There are no items in this pantry</p>
            <% } else { %>
                <% foods.forEach((item)=> { %>
                    <li>
                        <%= item.name %>

                        

                    <a href="/users/<%= user._id %>/foods/<%= item._id %>/edit" class="btn">
                        Edit Item
                    </a>

                        <form action="/users/<%= user._id %>/foods/<%= item._id %>?_method=DELETE" method="POST">
                            <button type="submit">Delete Item</button>
                        </form>
                    </li>
                    <% }) %>
                        <% } %>
    </ul>
</body>

</html>