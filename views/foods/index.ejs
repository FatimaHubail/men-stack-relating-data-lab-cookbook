<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
</head>

<body>
    <%- include('../partials/_navbar') %>
    <h1>The Pantry Shelf</h1>
    <a href="/users/<%= user._id %>/foods/new" class="add-btn">Add New Item</a>

    <!-- Items -->
    <ul class="grid-list">
        <% if (foods.length===0) { %>
            <p>There are no items in this pantry</p>
            <% } else { %>
                <% foods.forEach((item)=> { %>
                    <li>
                        <%= item.name %>

                        
                        <div class="item-actions">
                            <a href="/users/<%= user._id %>/foods/<%= item._id %>/edit" class="edit-btn">
                        Edit Item
                        </a>

                        <form action="/users/<%= user._id %>/foods/<%= item._id %>?_method=DELETE" method="POST" class="delete-btn">
                            <button type="submit">Delete Item</button>
                        </form>
                        </div>
                    
                    </li>
                    <% }) %>
                        <% } %>
    </ul>
</body>

</html>