<!DOCTYPE html>

<html lang="en">

<head>
    <link rel="stylesheet" href="/styles/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        <%= otherUser.username %>'s Pantry
    </title>
</head>

<body>

    <%- include('../partials/_navbar') %>

        <h1>
            What's in <%= otherUser.username %>'s Pantry?
        </h1>

        <ul class="grid-list">
            <% if (otherUser.pantry.length===0) { %>

                <p>This pantry is empty.</p>

                <% } else { %>

                    <% otherUser.pantry.forEach((item)=> { %>

                        <li>
                            <%= item.name %>
                        </li>

                        <% }) %>

                            <% } %>
        </ul>

</body>

</html>