<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community</title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <h1>Our Community</h1>

        <ul>
            <% users.forEach((otherUser)=> { %>
                <li>
                    <a href="/users/<%= otherUser._id %>">
                        <%= otherUser.username %>
                    </a>
                </li>
                <% }) %>
        </ul>
</body>

</html>